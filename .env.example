# ============================================================
#  Hospira Frontend - Variables d'environnement
# ============================================================
#  Copiez ce fichier en .env.local ou .env.<mode>.local
#  pour personnaliser les paramètres par environnement.
#
#  Fichiers lus par Vite (par ordre de priorité croissante) :
#    .env                  -- valeurs par défaut (committed)
#    .env.<mode>           -- valeurs par mode (committed)
#    .env.local            -- overrides locaux (ignoré par git)
#    .env.<mode>.local     -- overrides locaux par mode (ignoré par git)
#
#  Voir : https://vite.dev/guide/env-and-mode
# ============================================================

# URL de base de l'API backend.
# - En dev (vite dev) : doit pointer vers le serveur local (ex: http://localhost/Hospira/HospiraBackend/public/api)
# - En staging/production : chemin relatif ou absolu (ex: /api ou https://api.hospira.example.com/api)
VITE_API_BASE_URL=http://localhost/Hospira/HospiraBackend/public/api
